<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Documentos" pasa a ser ítem directo apuntando a todos los documentos -->
    <record id="documents_portal_management.menu_documents" model="ir.ui.menu">
        <field name="name">Documentos</field>
        <field name="action" ref="documents_portal_management.view_attachment_action_all_documents"/>
        <field name="sequence">2</field>
    </record>

    <!-- Ocultar submenús anteriores de Documentos (ahora es acción directa, no contenedor) -->
    <record id="documents_portal_management.menu_all_documents_action" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="documents_portal_management.menu_user_documents_action" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="documents_portal_management.menu_personal_documents_action" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- "Carpetas" sube al nivel raíz como contenedor sin acción directa -->
    <record id="documents_portal_management.folder_menu" model="ir.ui.menu">
        <field name="parent_id" ref="documents_portal_management.menu_root"/>
        <field name="action" eval="False"/>
        <field name="sequence">1</field>
    </record>

    <!-- Submenú: Todas las Carpetas (solo managers) -->
    <menuitem
        name="Todas las Carpetas"
        id="menu_all_folders"
        parent="documents_portal_management.folder_menu"
        action="documents_portal_management.folder_action"
        groups="documents_portal_management.group_document_manager"
        sequence="1"/>

    <!-- Submenú: Carpetas del Doctor (renombrado) -->
    <menuitem
        name="Carpetas del Doctor"
        id="menu_portal_folders"
        parent="documents_portal_management.folder_menu"
        action="action_portal_user_folders"
        groups="documents_portal_management.group_document_manager"
        sequence="2"/>
    
    <!-- Submenú: Carpetas del Paciente (nuevo) -->
    <menuitem
        name="Carpetas del Paciente"
        id="menu_patient_folders"
        parent="documents_portal_management.folder_menu"
        action="action_patient_folders"
        groups="documents_portal_management.group_document_manager"
        sequence="3"/>

    <!-- "Configuración" pasa a secuencia 3 -->
    <record id="documents_portal_management.configuration" model="ir.ui.menu">
        <field name="sequence">3</field>
    </record>

</odoo>