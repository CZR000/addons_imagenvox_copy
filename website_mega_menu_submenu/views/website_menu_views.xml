<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- HEREDAR VISTA TREE (Lista) -->
    <record id="view_website_menu_tree_inherit_submenu" model="ir.ui.view">
        <field name="name">website.menu.tree.inherit.submenu</field>
        <field name="model">website.menu</field>
        <field name="inherit_id" ref="website.menu_tree"/>
        <field name="arch" type="xml">
            <field name="is_mega_menu" position="after">
                <field name="use_dynamic_mega_menu" optional="show"/>
            </field>
        </field>
    </record>
    
    <!-- HEREDAR VISTA FORM (Formulario) -->
    <record id="view_website_menu_form_inherit_submenu" model="ir.ui.view">
        <field name="name">website.menu.form.inherit.submenu</field>
        <field name="model">website.menu</field>
        <field name="inherit_id" ref="website.website_menus_form_view"/>
        <field name="arch" type="xml">
            
            <!-- Agregar campo después de is_mega_menu -->
            <field name="is_mega_menu" position="after">
                <field name="use_dynamic_mega_menu" 
                       invisible="not is_mega_menu"
                       help="Si está activo, el mega menú se generará dinámicamente desde los items configurados abajo"/>
            </field>
            
            <!-- OCULTAR "child_id" cuando está activo el mega menú dinámico -->
            <label for="child_id" position="attributes">
                <attribute name="invisible">use_dynamic_mega_menu</attribute>
            </label>
            
            <field name="child_id" position="attributes">
                <attribute name="invisible">use_dynamic_mega_menu</attribute>
            </field>
            
            <!-- Agregar notebook ANTES del campo child_id -->
            <label for="child_id" position="before">
                <notebook invisible="not is_mega_menu or not use_dynamic_mega_menu">
                    <page string="Items del Mega Menú" name="mega_menu_items">
                        <field name="mega_menu_item_ids">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="url"/>
                                <field name="is_visible"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </label>
            
        </field>
    </record>
    
    <!-- VISTA FORM para website.menu.mega.item -->
    <record id="view_website_menu_mega_item_form" model="ir.ui.view">
        <field name="name">website.menu.mega.item.form</field>
        <field name="model">website.menu.mega.item</field>
        <field name="arch" type="xml">
            <form string="Item del Mega Menú">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="menu_id" invisible="1"/>
                            <field name="has_submenu" invisible="1"/>
                            <field name="url" invisible="has_submenu"/>
                            <field name="icon"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="column_position"/>
                            <field name="column_width"/>
                            <field name="new_window"/>
                            <field name="is_visible"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Sub-items">
                            <field name="submenu_item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="url"/>
                                    <field name="icon" optional="show"/>
                                    <field name="new_window" optional="hide"/>
                                    <field name="is_visible"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- VISTA LIST para website.menu.mega.item -->
    <record id="view_website_menu_mega_item_list" model="ir.ui.view">
        <field name="name">website.menu.mega.item.list</field>
        <field name="model">website.menu.mega.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url"/>
                <field name="has_submenu"/>
                <field name="column_position"/>
                <field name="column_width"/>
                <field name="is_visible"/>
            </list>
        </field>
    </record>
    
    <!-- ACCIÓN -->
    <record id="action_website_menu_mega_item" model="ir.actions.act_window">
        <field name="name">Items del Mega Menú</field>
        <field name="res_model">website.menu.mega.item</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- MENÚ en backend -->
    <menuitem
        id="menu_website_mega_menu_items"
        name="Items del Mega Menú"
        parent="website.menu_website_configuration"
        action="action_website_menu_mega_item"
        sequence="15"
        groups="website.group_website_designer"/>
    
</odoo>