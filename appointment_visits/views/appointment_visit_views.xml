<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_appointment_visit_list" model="ir.ui.view">
        <field name="name">appointment.visit.list</field>
        <field name="model">appointment.visit</field>
        <field name="arch" type="xml">
            <list string="Visitas">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="doctor_id"/>
                <field name="visit_date"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="is_interview" optional="hide"/>
                <field name="leave_brochure" optional="hide"/>
                <field name="interviewee_type" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_appointment_visit_form" model="ir.ui.view">
        <field name="name">appointment.visit.form</field>
        <field name="model">appointment.visit</field>
        <field name="arch" type="xml">
            <form string="Visita">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="doctor_id"/>
                            <field name="is_interview"/>
                            <field name="leave_brochure"/>
                            <field name="interviewee_type"/>
                        </group>
                        <group>
                            <field name="visit_date"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="notes" nolabel="1" placeholder="Detalle de la visita..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_appointment_visit_search" model="ir.ui.view">
        <field name="name">appointment.visit.search</field>
        <field name="model">appointment.visit</field>
        <field name="arch" type="xml">
            <search string="Buscar Visitas">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="doctor_id"/>
                <field name="visit_date"/>
                <field name="interviewee_type"/>
                <filter string="Entrevista" name="filter_interview" domain="[('is_interview','=',True)]"/>
                <filter string="Dejar folleto" name="filter_brochure" domain="[('leave_brochure','=',True)]"/>
                <separator/>
                <filter string="Hoy" name="today" domain="[('visit_date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Doctor" name="group_doctor" context="{'group_by':'doctor_id'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by':'visit_date'}"/>
                    <filter string="Entrevista" name="group_interview" context="{'group_by':'is_interview'}"/>
                    <filter string="Tipo de Entrevista" name="group_interviewee_type" context="{'group_by':'interviewee_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_appointment_visit" model="ir.actions.act_window">
        <field name="name">Visitas</field>
        <field name="res_model">appointment.visit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_appointment_visit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primera visita</p>
        </field>
    </record>

    <!-- Menú raíz (aparece en el app switcher con el ícono) -->
    <menuitem id="menu_visits_root"
              name="Visitas"
              web_icon="appointment_visits,static/description/icon.png"
              sequence="90"/>
    
    <!-- Menú de primer nivel dentro de la app -->
    <menuitem id="menu_visits_main"
              name="Visitas"
              parent="menu_visits_root"
              action="action_appointment_visit"
              sequence="10"/>
    
    <!-- (opcional) menú de configuración -->
    <menuitem id="menu_visits_config"
              name="Configuración"
              parent="menu_visits_root"
              sequence="90"
              groups="base.group_system"/>

</odoo>
